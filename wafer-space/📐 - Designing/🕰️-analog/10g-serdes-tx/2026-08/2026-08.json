    {
      "id": "1540760684848087230",
      "type": "Default",
      "timestamp": "2026-08-22T16:32:53.217+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "The Tx to Rx path is currently a 3-tap CML TX, T-coil/midpoint ESD pad,  differential channel, then dual-stage CTLE, VGA and separate data/monitor slicers. EQ adaptation uses shadow tuning codes allowing for simulated 1cm to 30cm “cable”. the monitor slicer measures eye/BER, the firmware qualifies a new code, then atomically swaps or rolls back, so the live data slicer is not disturbed while tuning.",
      "author": {
        "id": "810650258819252274",
        "name": "djsftree",
        "discriminator": "0000",
        "nickname": "djsftree",
        "color": null,
