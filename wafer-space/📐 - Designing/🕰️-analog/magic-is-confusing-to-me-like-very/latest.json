      "stickers": [],
      "reactions": [],
      "mentions": [
        {
          "id": "738396032295108721",
          "name": "bailey8889",
          "discriminator": "0000",
          "nickname": "bailey",
          "color": null,
          "isBot": false,
          "roles": [],
