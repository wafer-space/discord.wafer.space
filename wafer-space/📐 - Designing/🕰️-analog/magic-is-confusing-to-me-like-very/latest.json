    {
      "id": "1554668233250832437",
      "type": "Reply",
      "timestamp": "2026-09-30T01:36:31.146+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "OK, so, what I would enjoy is hierachical LVS but global/flattened PEX.\nYes, including as needed 0-ohm's to maintain appropriate local naming of nets. And eliding those 0-ohm's where that'll not create conflicts, i.e., just propagating such a name beyond to what would have been auto-named instead.",
      "author": {
        "id": "262706220073222144",
        "name": "namibj",
        "discriminator": "0000",
        "nickname": "namibj",
        "color": null,
        "isBot": false,
        "roles": [],
        "avatarUrl": "2026-09_media/f885abc0dddd0a33e4d4991b3c99091d-7ACD2.png"
      },
      "attachments": [],
