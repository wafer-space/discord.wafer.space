      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "The PSRR performance is so bad at high frequencies without the MIM caps",
      "author": {
        "id": "545723870431150080",
        "name": "jonahsaunders",
        "discriminator": "0000",
        "nickname": "Jonah Saunders",
        "color": null,
