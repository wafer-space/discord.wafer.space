      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "Ok, there are some small diodes on the input path after the resistor. But still, the main clamp are the actual drive transistors AFAICT.",
      "author": {
        "id": "596068704471482370",
        "name": "246tnt",
        "discriminator": "0000",
        "nickname": "tnt",
        "color": null,
        "isBot": false,
        "roles": [],
