    {
      "id": "1534570915252408443",
      "type": "Default",
      "timestamp": "2026-08-05T14:36:57.145+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "The small diodes are standard (from what I've seen). Usually the path is: ESD main protections (GT mos or similar) - resistor - \"small diodes\" - core of the circuit",
      "author": {
        "id": "693526428729344040",
        "name": "brunny95",
        "discriminator": "0000",
        "nickname": "Brunny",
        "color": null,
        "isBot": false,
        "roles": [],
        "avatarUrl": "2026-08_media/4f73efbb4824af137fec1ba3d7004c02-7FACC.png"
      },
      "attachments": [],
