    },
    {
      "id": "1534571909847580734",
      "type": "Reply",
      "timestamp": "2026-08-05T14:40:54.275+00:00",
      "timestampEdited": "2026-08-05T14:41:15.494+00:00",
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "It is known to me as secondary protection and the purpose is to get some extra voltage drop over the resistance during an ESD event to protect the connected gates.\nThe diode also has a capacitance so the R-C acts as a low-pass filter on the input though so high frequency stuff typically needs IO with custom ESD protection.",
      "author": {
        "id": "728516105680846892",
        "name": "chips4makers",
        "discriminator": "0000",
        "nickname": "Chips4Makers aka Staf Verhaegen",
