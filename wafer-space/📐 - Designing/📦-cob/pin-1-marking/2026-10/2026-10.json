    {
      "id": "1557289510709239849",
      "type": "Default",
      "timestamp": "2026-10-07T07:12:32.393+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "OK, to avoid needing significant work on the 0p5x1, could we reduce the size to 1.3mm?  The hole can still be 0.8mm, just reduce the thickness of the exposed copper surround.  And then push it closer to the corner, so the centre is 1.25mm away from the edge cut on both sides.",
      "author": {
        "id": "691780627338625077",
        "name": "rebelmike",
        "discriminator": "0000",
        "nickname": "RebelMike",
        "color": null,
        "isBot": false,
        "roles": [],
        "avatarUrl": "2026-10_media/49aaff687e56f04e7bbdedf0077bab75-7DDB4.png"
