    {
      "id": "1549674580711448648",
      "type": "Reply",
      "timestamp": "2026-09-16T06:53:31.603+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "So, the device sucks the backing tape down onto it and then the pushers push up? Do you have control over the different push pins, or do they all go up at the same time? I assume the other things next to it are the UV leds?",
      "author": {
        "id": "169786952432746498",
        "name": "mithro_",
        "discriminator": "0000",
        "nickname": "Tim 'mithro' Ansell",
        "color": null,
        "isBot": false,
        "roles": [],
        "avatarUrl": "2026-09_media/9679bb77da48d47c905b398d98a83780-75B68.png"
      },
      "attachments": [],
      "embeds": [],
      "stickers": [],
      "reactions": [],
