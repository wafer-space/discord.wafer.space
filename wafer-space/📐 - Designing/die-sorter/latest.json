          "name": "anfroholic",
          "discriminator": "0000",
          "nickname": "Andrew Wingate",
          "color": null,
          "isBot": false,
          "roles": [
            {
              "id": "1423020172595298314",
              "name": "Mod",
              "color": null,
              "position": 4
            }
