    {
      "id": "1559114351854485526",
      "type": "Default",
      "timestamp": "2026-10-12T08:03:48.426+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "These figures show the functionality pretty well. During the QRS complex, you have many more data points. If the threshold is even adaptive, then you can further reduce the number of samples without loss of information when using correct reconstruction algorithms. \uD83D\uDE42",
      "author": {
        "id": "210834917125390336",
        "name": "simi150500",
        "discriminator": "0000",
        "nickname": "Simi",
