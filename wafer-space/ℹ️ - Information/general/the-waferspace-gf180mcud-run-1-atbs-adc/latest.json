    {
      "id": "1558986039920427019",
      "type": "Default",
      "timestamp": "2026-10-11T23:33:56.477+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "@Simi - I would summaries this as:\n\n@Simi has an ADC which optimizes for low power things and useful for battery power setups which have \"human scale\" O(1 kHz --> 100kHz) type requirements (wearables, biotracking, etc). Works best when signals have clear \"events\" in them.\n\nIs that correct?",
      "author": {
        "id": "169786952432746498",
        "name": "mithro_",
        "discriminator": "0000",
        "nickname": "Tim 'mithro' Ansell",
        "color": null,
        "isBot": false,
        "roles": [],
        "avatarUrl": "2026-10_media/9679bb77da48d47c905b398d98a83780-75B68.png"
      },
      "attachments": [],
      "embeds": [],
      "stickers": [],
      "reactions": [],
      "mentions": [
        {
          "id": "210834917125390336",
          "name": "simi150500",
          "discriminator": "0000",
          "nickname": "Simi",
          "color": null,
          "isBot": false,
          "roles": [],
          "avatarUrl": "2026-10_media/a645eaf5a4cabce372412d598760aa57-23883.png"
        }
