      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "## Test features and sawstreet. \nSo in our reticle design we had 30um on each side to give us the total 60um saw street. \n\nGF did not honor another 30um and started their test features right there.",
      "author": {
        "id": "756011607603019777",
        "name": "anfroholic",
        "discriminator": "0000",
        "nickname": "Andrew Wingate",
        "color": null,
        "isBot": false,
        "roles": [
          {
            "id": "1423020172595298314",
            "name": "Mod",
            "color": null,
            "position": 4
          }
        ],
        "avatarUrl": "2026-10_media/67bd670a335a2f955fb2ded57088a2cb-675B3.png"
      },
      "attachments": [],
      "embeds": [],
      "stickers": [],
      "reactions": [],
