    {
      "id": "1557678696628887604",
      "type": "Default",
      "timestamp": "2026-10-08T08:59:01.547+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "A sidenote.\nThe voltage range for the corners includes both external voltage drop and on-chip voltage drop. I have seen total +/- 10% with dividing it equally over both e.g. 5% external and 5% on-chip. This matches to have 4.5/5.5 spec no-chip for external vdd spec of 4.75/5.25.",
      "author": {
