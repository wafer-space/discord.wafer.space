      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "Some operations perform merging under the hood, while for others you either don't want due to performance reasons, or need to merge explicitly.\nhttps://www.klayout.de/drc_function_internals.html",
      "author": {
        "id": "323371864074485771",
        "name": "mole99",
        "discriminator": "0000",
        "nickname": "Leo Moser (mole99)",
        "color": null,
        "isBot": false,
        "roles": [
          {
            "id": "1423020172595298314",
            "name": "Mod",
            "color": null,
            "position": 4
          }
        ],
        "avatarUrl": "2026-11_media/3c7c17f3225f6e56f4dccd83f14383f2-73F83.png"
