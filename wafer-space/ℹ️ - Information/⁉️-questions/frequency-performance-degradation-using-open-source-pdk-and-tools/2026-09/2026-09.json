    },
    {
      "id": "1550040727931723847",
      "type": "Default",
      "timestamp": "2026-09-17T07:08:27.903+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "Hi @Simo6572,\n\nWas your previous chip created using the same GF180MCU process and a proprietary PDK, or did you use a different process?\n\nNote that the foundry-provided standard cell library in the open-source PDK uses the high-voltage transistors, which are slow. Tholin made a community-created standard cell library using the low-voltage transistors, which is much faster running at 3.3V. However, it hasn't been tested yet (the wafers are coming out of the fab this week).",
      "author": {
        "id": "323371864074485771",
        "name": "mole99",
        "discriminator": "0000",
        "nickname": "Leo Moser (mole99)",
        "color": null,
        "isBot": false,
