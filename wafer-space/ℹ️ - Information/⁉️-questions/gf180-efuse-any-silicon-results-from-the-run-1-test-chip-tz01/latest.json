    },
    {
      "id": "1570340695749951562",
      "type": "Default",
      "timestamp": "2026-11-12T07:33:17.386+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "I think @Egor Lukyanchenko  posted results. IIRC the gist of it was 5V works, 3v3 doesn't.  You'd have to find his post for the details ...",
      "author": {
        "id": "596068704471482370",
        "name": "246tnt",
