    {
      "id": "1570340765308031127",
      "type": "Default",
      "timestamp": "2026-11-12T07:33:33.97+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "And for (4) AFAIK it's all included, if it passes pre-check DRC you're good.",
      "author": {
        "id": "596068704471482370",
        "name": "246tnt",
        "discriminator": "0000",
        "nickname": "tnt",
        "color": null,
        "isBot": false,
        "roles": [],
