    "name": "Splitting the pad ring for a 5 V eFuse segment on a 1x0p5 slot. OK for precheck?",
    "topic": null
  },
  "dateRange": {
    "after": "2026-08-31T23:59:59.999+00:00",
    "before": "2026-10-01T00:00:00+00:00"
